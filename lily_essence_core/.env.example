# Local first-run profile for the Public Edition.
# setup_public generates LILY_OWNER_API_TOKEN locally and never prints it.
LILY_ENVIRONMENT=development
LILY_CORS_ALLOW_ORIGINS=http://localhost:5230,http://127.0.0.1:5230
LILY_OWNER_API_TOKEN=
LILY_OWNER_API_TOKEN_ENFORCED=true

# Configure at least one real text provider before starting Core.
LILY_BRAIN_PROVIDER=lmstudio
LILY_TEXT_FALLBACK_PROVIDER=openai_compat
LILY_TEXT_PROVIDER_CHAIN=lmstudio,openai_compat,claude,gemini
OPENAI_API_BASE=http://127.0.0.1:1234/v1
OPENAI_API_KEY=lm-studio
LILY_LOCAL_BRAIN_MODEL=your-local-model
LILY_OPENAI_COMPAT_BASE=http://127.0.0.1:1234/v1
LILY_OPENAI_COMPAT_API_KEY=
LILY_OPENAI_COMPAT_BRAIN_MODEL=your-model-name
CLAUDE_API_KEY=
GEMINI_API_KEY=

# The browser setup does not need these optional services.
LILY_OPENCLAW_ENABLED=false
LILY_DISABLED_COMPONENTS=voice,stt,openclaw,file,home
LILY_MONGO_MIRROR_ENABLED=false
LILY_STATE_DB_PATH=runtime/lily_state.sqlite3
LILY_OWNER_TIMEZONE=UTC
LILY_HUD_EVENT_SOURCES=dashboard,mobile_realm

# Optional local/remote voice route. Keep empty until you supply your own engine,
# reference audio, and model assets under the local ignored asset directories.
LILY_VOICE_PROVIDER=sovits
LILY_VOICE_SERVICE_URL=
GPTSOVITS_API_URL=http://127.0.0.1:10880
