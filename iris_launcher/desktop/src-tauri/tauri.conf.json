{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IRIS Launcher",
  "version": "0.1.0",
  "identifier": "app.astralily.iris-launcher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "shortDescription": "Native launcher for a local AstraLily installation",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
