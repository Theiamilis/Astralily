LILY_STT_VESSEL_HOST=127.0.0.1
LILY_STT_VESSEL_PORT=10894
LILY_STT_VESSEL_TOKEN=
LILY_ENVIRONMENT=development
LILY_STT_CORS_ALLOW_ORIGINS=*

# Cloud-first provider chain. Groq uses an OpenAI-compatible transcription endpoint.
LILY_STT_PROVIDER_CHAIN=groq,local
LILY_STT_GROQ_API_KEY=
LILY_STT_GROQ_BASE_URL=https://api.groq.com/openai/v1
LILY_STT_GROQ_MODEL=whisper-large-v3-turbo
LILY_STT_GROQ_TIMEOUT_SECONDS=30

# Local fallback. The model is loaded only when the local provider is used.
LILY_STT_MODEL=base
LILY_STT_DEVICE=cpu
LILY_STT_COMPUTE_TYPE=int8
LILY_STT_LANGUAGE=
LILY_STT_DOWNLOAD_ROOT=
LILY_STT_MAX_UPLOAD_BYTES=10485760
LILY_STT_MAX_AUDIO_SECONDS=45
LILY_STT_BEAM_SIZE=1
LILY_STT_CPU_THREADS=0
LILY_STT_NUM_WORKERS=1
LILY_STT_VAD_FILTER=true
LILY_STT_LOAD_ON_STARTUP=false
