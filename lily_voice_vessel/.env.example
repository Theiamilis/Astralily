# Lily Voice Vessel
LILY_VOICE_VESSEL_HOST=127.0.0.1
LILY_VOICE_VESSEL_PORT=10881
LILY_VOICE_VESSEL_TOKEN=
LILY_VOICE_AUDIO_URL_SIGNING_SECRET=
LILY_VOICE_AUDIO_URL_TTL_SECONDS=900
LILY_VOICE_CACHE_MAX_FILES=256
LILY_ENVIRONMENT=development
LILY_VOICE_CORS_ALLOW_ORIGINS=*
LILY_VOICE_DEFAULT_PROFILE=ja
LILY_VOICE_HEALTH_PROFILES=ja,en
# Split long clauses before GPT-SoVITS synthesis so words are not skipped.
LILY_VOICE_CLAUSE_MAX_CHARS=40

# GPT-SoVITS API on the same device as this vessel.
GPTSOVITS_API_URL=http://127.0.0.1:10880
LILY_VOICE_FFMPEG_PATH=ffmpeg

# Generic profile ids. Keep these stable even if the actual character/model changes.
LILY_VOICE_PROFILE_JA=ja
LILY_VOICE_PROFILE_EN=en
# Custom compare/testing profiles can use any id, for example zeta_en or watson_en.
# Define them with LILY_VOICE_PROFILE_<PROFILE_ID>_* env keys.

# Japanese voice profile
LILY_VOICE_PROFILE_JA_API_URL=http://127.0.0.1:10880
LILY_VOICE_PROFILE_JA_GPT_MODEL_PATH=
LILY_VOICE_PROFILE_JA_SOVITS_MODEL_PATH=
LILY_VOICE_PROFILE_JA_REF_AUDIO=../local_assets/voice_models/gpt-sovits/neptune/references/neutral.wav
LILY_VOICE_PROFILE_JA_REF_TEXT=こんにちは、リリーです。今日もそばにいて、あなたを手伝います。
LILY_VOICE_PROFILE_JA_TEXT_LANGUAGE=ja
LILY_VOICE_PROFILE_JA_PROMPT_LANGUAGE=ja
# Optional maximum output gain for quiet models. Positive gain is peak-limited.
LILY_VOICE_PROFILE_JA_GAIN_DB=0
# Optional post-synthesis pitch correction. Tempo is preserved.
LILY_VOICE_PROFILE_JA_PITCH_SEMITONES=0
# Optional emotion-specific reference overrides. Use runtime emotion labels such as
# neutral, happy, sad, angry, or warning.
# LILY_VOICE_PROFILE_JA_EMOTION_NEUTRAL_REF_AUDIO=../local_assets/voice_models/gpt-sovits/neptune/references/neutral.wav
# LILY_VOICE_PROFILE_JA_EMOTION_NEUTRAL_REF_TEXT=
# LILY_VOICE_PROFILE_JA_EMOTION_HAPPY_REF_AUDIO=../local_assets/voice_models/gpt-sovits/neptune/references/happy.wav
# LILY_VOICE_PROFILE_JA_EMOTION_HAPPY_REF_TEXT=
# LILY_VOICE_PROFILE_JA_EMOTION_SAD_REF_AUDIO=../local_assets/voice_models/gpt-sovits/neptune/references/sad.wav
# LILY_VOICE_PROFILE_JA_EMOTION_SAD_REF_TEXT=
# LILY_VOICE_PROFILE_JA_EMOTION_ANGRY_REF_AUDIO=../local_assets/voice_models/gpt-sovits/neptune/references/angry.wav
# LILY_VOICE_PROFILE_JA_EMOTION_ANGRY_REF_TEXT=

# Optional Kokomi Japanese profile. Download the paired GPT/SoVITS checkpoints
# and reference WAV into local_assets before enabling these keys locally.
# LILY_VOICE_PROFILE_KOKOMI_JA_API_URL=http://127.0.0.1:10880
# LILY_VOICE_PROFILE_KOKOMI_JA_GPT_MODEL_PATH=C:/absolute/path/to/kokomi/gpt.ckpt
# LILY_VOICE_PROFILE_KOKOMI_JA_SOVITS_MODEL_PATH=C:/absolute/path/to/kokomi/sovits.pth
# LILY_VOICE_PROFILE_KOKOMI_JA_REF_AUDIO=../local_assets/voice_models/gpt-sovits/kokomi/references/neutral.wav
# LILY_VOICE_PROFILE_KOKOMI_JA_REF_TEXT=The situation is ever-changing in a card game. To emerge victorious, you have to be willing to take some risks.
# LILY_VOICE_PROFILE_KOKOMI_JA_TEXT_LANGUAGE=ja
# LILY_VOICE_PROFILE_KOKOMI_JA_PROMPT_LANGUAGE=en
# LILY_VOICE_PROFILE_KOKOMI_JA_GAIN_DB=0
# LILY_VOICE_PROFILE_KOKOMI_JA_PITCH_SEMITONES=-0.5

# English voice profile
LILY_VOICE_PROFILE_EN_API_URL=http://127.0.0.1:10880
LILY_VOICE_PROFILE_EN_GPT_MODEL_PATH=
LILY_VOICE_PROFILE_EN_SOVITS_MODEL_PATH=
LILY_VOICE_PROFILE_EN_REF_AUDIO=static/ref_voice_en.wav
LILY_VOICE_PROFILE_EN_REF_TEXT=Hi, I'm Lily. I'm ready to keep you company and help today.
LILY_VOICE_PROFILE_EN_TEXT_LANGUAGE=en
LILY_VOICE_PROFILE_EN_PROMPT_LANGUAGE=en
LILY_VOICE_PROFILE_EN_GAIN_DB=0
# LILY_VOICE_PROFILE_EN_EMOTION_NEUTRAL_REF_AUDIO=static/ref_voice_en_neutral.wav
# LILY_VOICE_PROFILE_EN_EMOTION_NEUTRAL_REF_TEXT=
# LILY_VOICE_PROFILE_EN_EMOTION_HAPPY_REF_AUDIO=static/ref_voice_en_happy.wav
# LILY_VOICE_PROFILE_EN_EMOTION_HAPPY_REF_TEXT=
