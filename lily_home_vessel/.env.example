LILY_HOME_VESSEL_HOST=127.0.0.1
LILY_HOME_VESSEL_PORT=10896
LILY_HOME_VESSEL_TOKEN=
LILY_ENVIRONMENT=development
LILY_HOME_CORS_ALLOW_ORIGINS=*

# Semicolon-separated devices.
# Format: id=provider,host[,kind[,name[,room[,alias1|alias2[,mac-address]]]]]
# Example: bedroom_light=wiz,198.51.100.9,light,Bedroom Light,bedroom,kamar|lampu kamar,A8:BB:50:12:34:56
LILY_HOME_DEVICES=

# Optional JSON scene map. Example:
# {"cozy":[{"device":"bedroom_light","state":"on","brightness":35,"temperature_kelvin":2700}]}
LILY_HOME_SCENES=
LILY_HOME_SCENE_STORE_PATH=runtime/scenes.json

# WiZ local UDP settings. WiZ bulbs normally use UDP 38899.
LILY_HOME_WIZ_PORT=38899
LILY_HOME_WIZ_TIMEOUT_SECONDS=1.2
LILY_HOME_WIZ_DISCOVERY_BROADCAST=255.255.255.255
LILY_HOME_WIZ_DISCOVERY_TIMEOUT_SECONDS=2.0
LILY_HOME_WIZ_RECOVERY_DISCOVERY_TIMEOUT_SECONDS=0.8
LILY_HOME_WIZ_AUTO_DISCOVERY_ENABLED=true
LILY_HOME_WIZ_DISCOVERY_COOLDOWN_SECONDS=15
LILY_HOME_WIZ_HOST_CACHE_PATH=runtime/wiz-host-cache.json
LILY_HOME_OFFLINE_FAILURE_THRESHOLD=4
