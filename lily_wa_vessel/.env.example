LILY_CORE_URL=http://127.0.0.1:8000
LILY_WA_PROFILE=personal
# Personal secretary: off, shadow, active (manual), or auto (owner marked busy).
LILY_WA_SECRETARY_MODE=shadow
LILY_WA_SECRETARY_DELAY_MS=60000
LILY_WA_SECRETARY_COOLDOWN_MS=1800000
LILY_WA_PUBLIC_CONTROL_URL=http://127.0.0.1:8093
LILY_OWNER_API_TOKEN=
# Optional HTTPS Control Center URL shown by the private /sms summary command.
LILY_FAMILY_VIEWER_URL=
# Optional personal WA -> desktop HUD relay. It stays disabled by default.
LILY_WA_HUD_NOTIFICATIONS_ENABLED=false
LILY_WA_HUD_VOICE_ENABLED=false
LILY_WA_HUD_VOICE_LANGUAGE=id
LILY_WA_HUD_VOICE_PROFILE=id
LILY_WA_HUD_VOICE_ROUTE=
# Optional central router endpoint. Defaults to LILY_CORE_URL + /api/core/route-intent.
LILY_CORE_ROUTER_URL=
GEMINI_API_KEY=
LILY_CORE_MAC=XX:XX:XX:XX:XX:XX
LILY_WAKE_BROADCAST_IP=255.255.255.255
LILY_WAKE_PORT=9
OWNER_NUMBER=62812XXXXXXXX
ALLOWED_TEST_NUMBER=62812XXXXXXXX
BRIDGE_CONTROL_PORT=8091
BRIDGE_CONTROL_HOST=127.0.0.1
BRIDGE_CONTROL_TOKEN=
# Comma-separated browser origins allowed to call the control API. Wildcards are ignored.
LILY_WA_CONTROL_CORS_ALLOW_ORIGINS=http://127.0.0.1:5231,http://localhost:5231
LILY_WA_CONTROL_MAX_BODY_BYTES=16384
LILY_WA_CONTROL_AUDIT_MAX_BYTES=5242880
LILY_WAKE_API_TOKEN=
LILY_FILE_VESSEL_URL=http://127.0.0.1:10893
LILY_FILE_VESSEL_TOKEN=
# Optional multi-device File Vessel registry. If set, WA can search pc/laptop/nas instead of only LILY_FILE_VESSEL_URL.
# LILY_FILE_VESSEL_DEFAULT=pc
# LILY_FILE_VESSELS=pc=http://127.0.0.1:10893;laptop=http://127.0.0.1:10893
# LILY_FILE_VESSEL_LABELS=pc=pc;laptop=laptop
# LILY_FILE_VESSEL_ALIASES=pc=pc,komputer,windows,Lily-Storage-Host,Lily-Storage-Host,lily storage host;laptop=laptop,Lily-Core-Host,Lily-Core-Host,lily-core-host,linux,device ini
# LILY_FILE_VESSEL_TOKENS=pc=;laptop=
LILY_FINANCE_VESSEL_URL=http://127.0.0.1:10895
LILY_FINANCE_SERVICE_TOKEN=
LILY_FINANCE_CONFIRM_TTL_MS=300000
LILY_FINANCE_IMAGE_MAX_BYTES=5242880
LILY_TOOL_HEALTH_URL=http://127.0.0.1:8092/health
LILY_VOICE_HEALTH_URL=
LILY_VOICE_HEALTH_TOKEN=
LILY_STT_TRANSCRIBE_URL=http://127.0.0.1:10894/api/stt/transcribe
LILY_STT_HEALTH_URL=http://127.0.0.1:10894/health
LILY_STT_TOKEN=
LILY_STT_TIMEOUT_MS=60000
LILY_STT_MAX_AUDIO_BYTES=10485760
LILY_WA_AUTH_TIMEOUT_MS=120000
# Empty loads the current WhatsApp Web build. Pin only for a short validated rollback.
LILY_WA_WEB_VERSION=
# Optional override. Empty derives a non-headless Chrome UA from Puppeteer's bundled browser.
LILY_WA_USER_AGENT=
LILY_STATUS_CHECK_TIMEOUT_MS=1500
LILY_FILE_VESSEL_SEARCH_LIMIT=6
LILY_FILE_VESSEL_SEARCH_DEPTH=8
LILY_FILE_VESSEL_LIST_LIMIT=10
LILY_FILE_SEND_CONFIRM_TTL_MS=300000
LILY_FILE_SEARCH_CONTEXT_TTL_MS=1800000
LILY_WA_INTENT_ROUTER_TIMEOUT_MS=2600
LILY_WA_INTENT_ROUTER_MIN_CONFIDENCE=0.72
# Owner-only mood delivery. Only the public profile sends proactive messages.
LILY_WA_PROACTIVE_ENABLED=true
LILY_WA_PROACTIVE_POLL_MS=900000
LILY_WA_PROACTIVE_MIN_IDLE_MS=7200000
LILY_WA_PROACTIVE_COOLDOWN_MS=21600000
LILY_WA_PROACTIVE_MAX_PER_DAY=3
LILY_WA_PROACTIVE_QUIET_START_HOUR=23
LILY_WA_PROACTIVE_QUIET_END_HOUR=8
LILY_WA_PROACTIVE_TIMEZONE=Asia/Jakarta
LILY_WA_ROUTINES_ENABLED=true
LILY_WA_ROUTINE_POLL_MS=300000
LILY_WA_CORE_WATCHDOG_ENABLED=true
LILY_WA_CORE_WATCHDOG_POLL_MS=60000
# Delay and retry the optional external-chat backfill until WhatsApp Web is settled.
INBOX_BACKFILL_ENABLED=false
INBOX_BACKFILL_START_DELAY_MS=5000
INBOX_BACKFILL_RETRY_DELAY_MS=15000
# Optional fixed target. Empty uses the most recently active allowlisted owner number.
LILY_WA_PROACTIVE_OWNER_NUMBER=
LILY_WA_HUMANIZED_TIMING_ENABLED=true
LILY_WA_HUMANIZED_MIN_DELAY_MS=650
LILY_WA_HUMANIZED_MAX_DELAY_MS=3200
LILY_WA_HUMANIZED_SPLIT_RATE=0.28
# Owner-only temporary A/B mode. When true, owner text chat asks Core for
# Stream Voice (Google/Edge -> RVC) and sends the result as a WA voice note.
LILY_WA_STREAM_VOICE_TEST_ENABLED=false
OPENCLAW_DELIVERY_POLL_MS=5000
OPENCLAW_RESULT_MAX_CHARS=3000
WA_ATTACHMENT_MAX_BYTES=20971520
WA_IMAGE_ATTACHMENT_MAX_BYTES=15728640
WA_ATTACHMENT_CACHE_TTL_MS=600000
