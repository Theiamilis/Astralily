# Lily Tool Vessel
LILY_TOOL_VESSEL_HOST=127.0.0.1
LILY_TOOL_VESSEL_PORT=8092
LILY_TOOL_VESSEL_TOKEN=
LILY_ENVIRONMENT=development
LILY_TOOL_CORS_ALLOW_ORIGINS=*

# Which external agent this vessel runs.
# Supported: hermes, openclaw
LILY_TOOL_AGENT_PROVIDER=hermes
LILY_TOOL_FALLBACK_ENABLED=true
LILY_TOOL_AGENT_FALLBACK_CHAIN=hermes,openclaw
LILY_TOOL_TIMEOUT_SECONDS=180

# Deterministic, owner-confirmed remote power executor. Targets live in config/topology.json.
LILY_DEVICE_POWER_TOPOLOGY=../config/topology.json
LILY_DEVICE_POWER_SSH_TIMEOUT_SECONDS=12
LILY_DEVICE_POWER_AUDIT_PATH=runtime/device_power_audit.jsonl
LILY_DEVICE_POWER_WATCHER_TIMEOUT_SECONDS=300
LILY_DEVICE_POWER_WATCHER_POLL_SECONDS=5
LILY_DEVICE_POWER_EVENT_URL=http://127.0.0.1:8000/api/power/events

# Artifact delivery. Hermes/OpenClaw can save generated files here for Lily to attach.
LILY_TOOL_ARTIFACT_DIR=runtime/artifacts
LILY_TOOL_ARTIFACT_MAX_BYTES=20971520
LILY_TOOL_ARTIFACT_ALLOWED_EXTENSIONS=png,jpg,jpeg,webp,gif,pdf,docx,xlsx,txt,md,zip
LILY_TOOL_INPUT_MAX_BYTES=20971520
LILY_TOOL_INPUT_ALLOWED_EXTENSIONS=pdf

# The workspace the agent should operate in.
# Windows example: C:\path\to\LilyConstellation
# Linux example: /home/lily/LilyAi
LILY_TOOL_WORKDIR=C:\path\to\LilyConstellation

# External CLI commands. Use absolute paths if they are not on PATH.
LILY_HERMES_CLI=hermes
LILY_OPENCLAW_CLI=openclaw

# Optional external agent homes. Keep these outside the Lily repo.
HERMES_HOME=C:\AI\LilyAgents\hermes-home
OPENCLAW_HOME=C:\AI\LilyAgents\openclaw-home
